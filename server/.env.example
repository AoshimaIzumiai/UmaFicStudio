# UmaFicStudio API 环境变量
# 复制为 .env 并填入实际值

# 环境：test / development / production
APP_ENV=development

# JWT 密钥（生产必须更换为随机 32+ 字节）
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=uma_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=umafic

# 管理员密钥（仅 localhost 可用）
ADMIN_KEY=CHANGE_ME

# CORS 允许的源（逗号分隔）
# CORS_ORIGINS=["https://umaficstudio.com","http://localhost:8080"]

# 离线维护任务（默认禁用；仅显式 CLI --execute 时可写入）
MAINTENANCE_ENABLED=false
TOMBSTONE_PAYLOAD_RETENTION_DAYS=7
MAINTENANCE_BATCH_SIZE=500
